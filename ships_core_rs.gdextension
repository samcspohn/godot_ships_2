[configuration]

entry_symbol = "gdext_rust_init"
compatibility_minimum = "4.1"
reloadable = true

[libraries]

linux.debug.x86_64 = "res://bin/libships_core_rs.linux.x86_64.so"
linux.release.x86_64 = "res://bin/libships_core_rs.linux.x86_64.so"
linux.editor.x86_64 = "res://bin/libships_core_rs.linux.x86_64.so"
